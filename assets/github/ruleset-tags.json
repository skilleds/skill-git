{
  "name": "tags v* e hml-* imutáveis (schematize-git)",
  "target": "tag",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*",
        "refs/tags/hml-*"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "update"
    }
  ]
}
